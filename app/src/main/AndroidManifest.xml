<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Only for the updater: reads this fork's GitHub releases and installs a build the user asks for. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <queries>
        <package android:name="com.google.android.projection.gearhead" />
        <!-- To list the apps that have a launcher icon, for per-app icon choices. Read on the phone only. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".AaExperimentApplication"
        android:allowBackup="true"
        android:description="@string/module_description"
        android:icon="@drawable/app_icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/app_icon"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".RestartTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_restart"
            android:label="Restart Android Auto"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver android:name=".UpdateStatusReceiver" android:exported="false" />

        <!-- Local reports from the module inside Android Auto; callers are checked by uid. -->
        <provider
            android:name=".ModuleReportProvider"
            android:authorities="io.github.highwindbr.aaxp.reports"
            android:exported="true" />

        <service
            android:name=".AnalysisKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

    </application>
</manifest>
